<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MindEase.Views.LoginPage"
    Title="Login"
    BackgroundColor="#F4FAF7"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <Label
                Text="🌿"
                FontSize="70"
                HorizontalOptions="Center"/>

            <Label
                Text="Welcome Back"
                FontSize="32"
                FontAttributes="Bold"
                HorizontalOptions="Center"/>

            <Label
                Text="Sign in to continue"
                HorizontalOptions="Center"
                TextColor="Gray"/>

            <Entry
                x:Name="EmailEntry"
                Placeholder="Email"
                Keyboard="Email"
                HeightRequest="55"/>

            <Entry
                x:Name="PasswordEntry"
                Placeholder="Password"
                IsPassword="True"
                HeightRequest="55"/>

            <Grid>

                <Button
                    x:Name="LoginButton"
                    Text="Login"
                    HeightRequest="55"
                    BackgroundColor="#2F8F6E"
                    TextColor="White"
                    CornerRadius="15"
                    Clicked="LoginButton_Clicked"/>

                <ActivityIndicator
                    x:Name="LoginSpinner"
                    IsRunning="False"
                    IsVisible="False"
                    Color="White"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>

            </Grid>

            <Label
                x:Name="LoadingHintLabel"
                Text="This can take up to a minute if the server was asleep..."
                FontSize="12"
                TextColor="Gray"
                HorizontalOptions="Center"
                IsVisible="False"/>

            <Button
                x:Name="RegisterButton"
                Text="Create Account"
                BackgroundColor="Transparent"
                TextColor="#2F8F6E"
                Clicked="RegisterButton_Clicked"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>