<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MindEase.Views.JournalPage"
    Title="My Journal">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="15">

            <Label
                Text="📖 My Journal"
                FontSize="30"
                FontAttributes="Bold" />

            <Entry
                x:Name="TitleEntry"
                Placeholder="Journal title"
                HeightRequest="50" />

            <Editor
                x:Name="ContentEditor"
                Placeholder="Write what's on your mind..."
                HeightRequest="180"
                AutoSize="TextChanges" />

            <Button
                Text="Save Journal Entry"
                HeightRequest="55"
                CornerRadius="15"
                Clicked="SaveJournal_Clicked" />

            <Label
                Text="Previous Entries"
                FontSize="22"
                FontAttributes="Bold"
                Margin="0,20,0,0" />

            <CollectionView
                x:Name="JournalCollection">

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Padding="15"
                            Margin="0,5">

                            <VerticalStackLayout
                                Spacing="5">

                                <Label
                                    Text="{Binding Title}"
                                    FontSize="18"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding Content}"
                                    FontSize="15" />

                                <Label
                                    Text="{Binding Date}"
                                    FontSize="12"
                                    TextColor="Gray" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>