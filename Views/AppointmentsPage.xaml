<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MindEase.Views.AppointmentsPage"
    Title="Book Appointment">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="15">

            <HorizontalStackLayout
                Spacing="10"
                VerticalOptions="Center">

                <Image
                    Source="icon_leaf_header.svg"
                    HeightRequest="26"
                    WidthRequest="26" />

                <Label
                    Text="Book an Appointment"
                    FontSize="28"
                    FontAttributes="Bold"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>

            <Label
                Text="Therapists Near You"
                FontSize="20"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <Label
                x:Name="LocationStatusLabel"
                Text="Finding your location..."
                FontSize="13"
                TextColor="Gray" />

            <Button
                Text="Refresh Location"
                ImageSource="icon_refresh.svg"
                ContentLayout="Left,10"
                Clicked="RefreshLocation_Clicked" />

            <CollectionView
                x:Name="NearbyTherapistsCollection"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label
                        Text="No therapists found."
                        TextColor="Gray"
                        Margin="0,10" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Padding="15"
                            Margin="0,5"
                            StrokeThickness="2"
                            Stroke="{Binding BorderColor}">

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="{Binding Name}"
                                    FontAttributes="Bold"
                                    FontSize="17" />

                                <Label
                                    Text="{Binding Specialty}"
                                    FontSize="13"
                                    TextColor="Gray" />

                                <Label
                                    Text="{Binding DistanceText}"
                                    FontSize="13"
                                    FontAttributes="Bold" />

                                <Label
                                    Text="{Binding OfficeAddress}"
                                    FontSize="12"
                                    TextColor="Gray" />

                            </VerticalStackLayout>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TherapistCard_Tapped" CommandParameter="{Binding Id}" />
                            </Border.GestureRecognizers>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

            <VerticalStackLayout
                x:Name="BookingSection"
                IsVisible="False"
                Spacing="15"
                Margin="0,15,0,0">

                <BoxView
                    HeightRequest="1"
                    Color="LightGray" />

                <Label
                    x:Name="SelectedTherapistLabel"
                    FontSize="20"
                    FontAttributes="Bold"
                    Margin="0,10,0,0" />

                <Label
                    x:Name="BioLabel"
                    Text=""
                    FontSize="13"
                    TextColor="Gray" />

                <Label
                    Text="Choose session type"
                    FontSize="15"
                    TextColor="Gray" />

                <Border
                    x:Name="InPersonBorder"
                    Padding="15"
                    StrokeThickness="2">

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                        <Image
                            Grid.Column="0"
                            Source="icon_office.svg"
                            HeightRequest="22"
                            WidthRequest="22"
                            VerticalOptions="Start" />

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label
                                Text="In-Person"
                                FontAttributes="Bold" />
                            <Label
                                Text="Visit the therapist at their office."
                                FontSize="12"
                                TextColor="Gray" />
                        </VerticalStackLayout>

                        <Label
                            x:Name="InPersonPriceLabel"
                            Grid.Column="2"
                            VerticalOptions="Center"
                            FontAttributes="Bold" />

                    </Grid>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="InPersonOption_Tapped" />
                    </Border.GestureRecognizers>

                </Border>

                <Border
                    x:Name="OnlineBorder"
                    Padding="15"
                    StrokeThickness="2">

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                        <Image
                            Grid.Column="0"
                            Source="icon_video.svg"
                            HeightRequest="22"
                            WidthRequest="22"
                            VerticalOptions="Start" />

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label
                                Text="Online"
                                FontAttributes="Bold" />
                            <Label
                                Text="Meet with the therapist through a video call."
                                FontSize="12"
                                TextColor="Gray" />
                        </VerticalStackLayout>

                        <Label
                            x:Name="OnlinePriceLabel"
                            Grid.Column="2"
                            VerticalOptions="Center"
                            FontAttributes="Bold" />

                    </Grid>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnlineOption_Tapped" />
                    </Border.GestureRecognizers>

                </Border>

                <Border
                    x:Name="PhoneBorder"
                    Padding="15"
                    StrokeThickness="2">

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                        <Image
                            Grid.Column="0"
                            Source="icon_phonecall.svg"
                            HeightRequest="22"
                            WidthRequest="22"
                            VerticalOptions="Start" />

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label
                                Text="Phone"
                                FontAttributes="Bold" />
                            <Label
                                Text="Speak with the therapist over the phone."
                                FontSize="12"
                                TextColor="Gray" />
                        </VerticalStackLayout>

                        <Label
                            x:Name="PhonePriceLabel"
                            Grid.Column="2"
                            VerticalOptions="Center"
                            FontAttributes="Bold" />

                    </Grid>

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="PhoneOption_Tapped" />
                    </Border.GestureRecognizers>

                </Border>

                <Label
                    Text="Choose a date"
                    FontSize="15"
                    TextColor="Gray"
                    Margin="0,10,0,0" />

                <DatePicker
                    x:Name="AppointmentDatePicker" />

                <Label
                    Text="Choose a time"
                    FontSize="15"
                    TextColor="Gray" />

                <TimePicker
                    x:Name="AppointmentTimePicker" />

                <Label
                    Text="Optional message to therapist"
                    FontSize="15"
                    TextColor="Gray"
                    Margin="0,10,0,0" />

                <Editor
                    x:Name="MessageEditor"
                    HeightRequest="80"
                    Placeholder="Anything you'd like the therapist to know beforehand..." />

                <Button
                    Text="Review &amp; Request Appointment"
                    ImageSource="icon_review.svg"
                    ContentLayout="Left,10"
                    Clicked="ReviewBooking_Clicked"
                    Margin="0,15,0,0" />

            </VerticalStackLayout>

            <BoxView
                HeightRequest="1"
                Color="LightGray"
                Margin="0,15" />

            <Label
                Text="Your Appointments"
                FontSize="22"
                FontAttributes="Bold" />

            <CollectionView
                x:Name="AppointmentsCollection"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label
                        Text="No appointments booked yet."
                        TextColor="Gray"
                        Margin="0,10" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Padding="15"
                            Margin="0,5"
                            StrokeThickness="1">

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="{Binding TherapistName}"
                                    FontAttributes="Bold"
                                    FontSize="16" />

                                <Label
                                    Text="{Binding AppointmentDate, StringFormat='{0:dddd, dd MMM yyyy - HH:mm}'}"
                                    FontSize="14" />

                                <Label
                                    Text="{Binding SessionTypeAndPrice}"
                                    FontSize="13" />

                                <Label
                                    Text="{Binding Status}"
                                    FontSize="13"
                                    TextColor="Gray" />

                                <Button
                                    Text="Cancel"
                                    IsVisible="{Binding CanCancel}"
                                    Clicked="CancelAppointment_Clicked"
                                    CommandParameter="{Binding Id}" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
