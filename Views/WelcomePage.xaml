<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MindEase.Views.WelcomePage"
    BackgroundColor="#F5F9FC"
    NavigationPage.HasNavigationBar="False">

    <VerticalStackLayout
        Padding="30"
        VerticalOptions="Center"
        Spacing="25">

        <Label
            Text="🌿"
            FontSize="80"
            HorizontalOptions="Center" />

        <Label
            Text="MindEase"
            FontSize="40"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            TextColor="#2E7D32" />

        <Label
            Text="Your safe space, one day at a time."
            FontSize="18"
            HorizontalTextAlignment="Center"
            TextColor="Gray" />

        <Button
            x:Name="GetStartedButton"
            Text="Get Started"
            BackgroundColor="#4A90E2"
            TextColor="White"
            CornerRadius="15"
            HeightRequest="55"
            FontSize="18"
            Clicked="GetStartedButton_Clicked" />

    </VerticalStackLayout>

</ContentPage>