<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MindEase.Views.CrisisResourcesPage"
    Title="Crisis Resources">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="18">

            <Label
                Text="🆘 Need Help Right Now?"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="If you or someone you know is in immediate danger, please contact emergency services or one of the resources below."
                FontSize="15"
                TextColor="Gray" />

            <Border
                Padding="18"
                StrokeThickness="1">

                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="South African Depression and Anxiety Group (SADAG)"
                        FontAttributes="Bold"
                        FontSize="17" />
                    <Label
                        Text="0800 567 567 (24-hour helpline)"
                        FontSize="15" />
                    <Button
                        Text="📞 Call SADAG"
                        Clicked="CallSadag_Clicked" />
                </VerticalStackLayout>

            </Border>

            <Border
                Padding="18"
                StrokeThickness="1">

                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="Suicide Crisis Line"
                        FontAttributes="Bold"
                        FontSize="17" />
                    <Label
                        Text="0800 567 567 or SMS 31393"
                        FontSize="15" />
                    <Button
                        Text=" Call Now"
                        Clicked="CallSuicideLine_Clicked" />
                </VerticalStackLayout>

            </Border>

            <Border
                Padding="18"
                StrokeThickness="1">

                <VerticalStackLayout Spacing="6">
                    <Label
                        Text="Emergency Services"
                        FontAttributes="Bold"
                        FontSize="17" />
                    <Label
                        Text="10111 (Police) / 10177 (Ambulance)"
                        FontSize="15" />
                    <Button
                        Text=" Call Emergency"
                        Clicked="CallEmergency_Clicked" />
                </VerticalStackLayout>

            </Border>

            <Label
                Text="You are not alone. Reaching out is a sign of strength, not weakness. 🌿"
                FontSize="15"
                FontAttributes="Italic"
                HorizontalTextAlignment="Center"
                Margin="0,10,0,0" />

            <Button
                Text="⬅ Back to Home"
                Clicked="BackToHome_Clicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>