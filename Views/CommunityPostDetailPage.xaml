<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MindEase.Views.CommunityPostDetailPage"
    Title="Post">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">

            <VerticalStackLayout
                Padding="20"
                Spacing="15">

                <Border Padding="15">
                    <VerticalStackLayout Spacing="6">
                        <Label
                            x:Name="PostContentLabel"
                            FontSize="16" />
                        <Label
                            x:Name="PostMetaLabel"
                            FontSize="12"
                            TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>

                <Label
                    Text="Comments"
                    FontSize="18"
                    FontAttributes="Bold" />

                <CollectionView
                    x:Name="CommentsCollection"
                    SelectionMode="None">

                    <CollectionView.EmptyView>
                        <Label
                            Text="No comments yet."
                            TextColor="Gray" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Padding="12"
                                Margin="0,4"
                                StrokeThickness="1">

                                <VerticalStackLayout Spacing="4">

                                    <Label
                                        Text="{Binding Content}"
                                        FontSize="14" />

                                    <Label
                                        Text="{Binding Meta}"
                                        FontSize="11"
                                        TextColor="Gray" />

                                    <Button
                                        Text="Report"
                                        BackgroundColor="Transparent"
                                        TextColor="Gray"
                                        Padding="0"
                                        FontSize="12"
                                        HorizontalOptions="Start"
                                        CommandParameter="{Binding Id}"
                                        Clicked="ReportComment_Clicked" />

                                </VerticalStackLayout>

                            </Border>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </ScrollView>

        <VerticalStackLayout
            Grid.Row="1"
            Padding="15"
            Spacing="10"
            BackgroundColor="#F4FAF7">

            <Entry
                x:Name="NewCommentEntry"
                Placeholder="Write a supportive comment..." />

            <HorizontalStackLayout Spacing="10">
                <CheckBox
                    x:Name="CommentAnonymousCheckBox" />
                <Label
                    Text="Comment anonymously"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button
                Text="Send"
                Clicked="SendComment_Clicked" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>