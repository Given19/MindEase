<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MindEase.Views.CommunityPage"
    Title="Community">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout
            Grid.Row="0"
            Padding="20"
            Spacing="10"
            BackgroundColor="#F4FAF7">

            <Label
                Text="Share what's on your mind"
                FontSize="16"
                FontAttributes="Bold" />

            <Editor
                x:Name="NewPostEditor"
                HeightRequest="80"
                Placeholder="Write something... other members can read and respond." />

            <HorizontalStackLayout Spacing="10">
                <CheckBox
                    x:Name="AnonymousCheckBox" />
                <Label
                    Text="Post anonymously"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button
                Text="Post"
                Clicked="PostButton_Clicked" />

        </VerticalStackLayout>

        <RefreshView
            Grid.Row="1"
            x:Name="PostsRefreshView"
            Refreshing="PostsRefreshView_Refreshing">

            <CollectionView
                x:Name="PostsCollection"
                SelectionMode="None"
                Margin="20,10">

                <CollectionView.EmptyView>
                    <Label
                        Text="No posts yet. Be the first to share something."
                        TextColor="Gray"
                        Margin="0,20" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Padding="15"
                            Margin="0,5"
                            StrokeThickness="1">

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="{Binding Content}"
                                    FontSize="15" />

                                <Label
                                    Text="{Binding Meta}"
                                    FontSize="12"
                                    TextColor="Gray" />

                                <HorizontalStackLayout Spacing="15">

                                    <Button
                                        Text="{Binding CommentCountText}"
                                        BackgroundColor="Transparent"
                                        TextColor="#2F8F6E"
                                        Padding="0"
                                        CommandParameter="{Binding Id}"
                                        Clicked="ViewPost_Clicked" />

                                    <Button
                                        Text="Report"
                                        BackgroundColor="Transparent"
                                        TextColor="Gray"
                                        Padding="0"
                                        CommandParameter="{Binding Id}"
                                        Clicked="ReportPost_Clicked" />

                                </HorizontalStackLayout>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </RefreshView>

    </Grid>

</ContentPage>