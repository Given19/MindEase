<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MindEase.Views.MoodHistoryPage"
    Title="Mood History">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="15">

            <Label
                Text=" Mood History"
                FontSize="30"
                FontAttributes="Bold" />

            <Label
                x:Name="SummaryLabel"
                Text=""
                FontSize="16"
                TextColor="Gray" />

            <CollectionView
                x:Name="MoodCollection"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label
                        Text="No mood entries yet. Log a mood from Home. 🌱"
                        HorizontalOptions="Center"
                        TextColor="Gray"
                        Margin="0,20" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Padding="15"
                            Margin="0,5"
                            StrokeThickness="1">

                            <Grid
                                ColumnDefinitions="Auto,*,Auto">

                                <Label
                                    Grid.Column="0"
                                    Text="{Binding EmojiText}"
                                    FontSize="26"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="{Binding Mood}"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    Margin="10,0,0,0"
                                    VerticalOptions="Center" />

                                <Label
                                    Grid.Column="2"
                                    Text="{Binding Date, StringFormat='{0:dd MMM, HH:mm}'}"
                                    FontSize="12"
                                    TextColor="Gray"
                                    VerticalOptions="Center" />

                            </Grid>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>